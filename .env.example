# Library RAG Bot Configuration

# Gemini API Key (Optional: if not provided, the application will use the high-precision local RAG fallback engine)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_API_KEY=your_llm_api_key_here

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# RAG Configuration
VECTOR_STORE_DIR=vector_store
DOCUMENTS_DIR=documents/sample_library_data
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K_RESULTS=4
SIMILARITY_THRESHOLD=0.15
